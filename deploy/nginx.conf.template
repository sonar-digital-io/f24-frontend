# Rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf.
# Only ${API_PROXY_*} are substituted; plain nginx $variables are left alone.
server {
    listen 8080;
    root /usr/share/nginx/html;
    # Behind ingress + tunnel our own port/scheme are wrong to the browser: keep redirects relative.
    absolute_redirect off;

    # OpenCascade.js needs SharedArrayBuffer -> cross-origin isolation (same as vercel.json).
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy require-corp always;

    location / {
        try_files $uri /index.html;
    }

    # Shared login (LoginGate.tsx). POST with the right Basic credentials sets the
    # cookie that /api/ requires; GET answers whether the cookie is already valid.
    # No WWW-Authenticate on the 401, so the browser shows no native popup.
    location = /gate {
        if ($http_authorization = "Basic ${GATE_AUTH_B64}") {
            add_header Set-Cookie "f24_gate=${GATE_AUTH_B64}; Path=/; Max-Age=2592000; HttpOnly; Secure; SameSite=Strict";
            return 204;
        }
        if ($cookie_f24_gate = "${GATE_AUTH_B64}") { return 204; }
        return 401;
    }

    # The browser only talks to this host; we forward to the external backend and make
    # the request look like it came from the backend's own origin, so the backend needs
    # no CORS / CSRF_TRUSTED_ORIGINS change.
    location /api/ {
        # Rewriting Origin below would switch off Django's CSRF check for every site on
        # the web, so enforce it here first: unsafe methods only from our own origin.
        set $csrf_block 1;
        if ($request_method ~ ^(GET|HEAD|OPTIONS)$) { set $csrf_block 0; }
        if ($http_origin = "https://$http_host") { set $csrf_block 0; }
        if ($http_origin = "http://$http_host") { set $csrf_block 0; }  # local docker run
        if ($csrf_block) { return 403; }
        if ($cookie_f24_gate != "${GATE_AUTH_B64}") { return 401; }

        # Resolve the backend per request, not once at startup: nginx then neither
        # refuses to start on a DNS hiccup nor keeps a stale IP.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=60s;
        set $api_upstream ${API_PROXY_TARGET};
        proxy_pass $api_upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_PROXY_HOST};
        proxy_set_header Origin ${API_PROXY_TARGET};
        proxy_set_header Referer ${API_PROXY_TARGET}$request_uri;
        proxy_set_header Authorization "Basic ${API_PROXY_AUTH_B64}";
        # Don't leak our hostname via the ingress's forwarding headers.
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Proto https;

        proxy_cookie_domain ~.+ $host;
        proxy_redirect ${API_PROXY_TARGET}/ /;

        client_max_body_size 100m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }
}
